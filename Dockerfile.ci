FROM node:20-alpine

# 与 .github/workflows/deploy.yml 使用同一 pnpm。
# 不固定版本时 npm 会装到 pnpm 10+，`pnpm install` 会因未批准的构建脚本失败：
# ERR_PNPM_IGNORED_BUILDS（@sentry/cli、sharp）。
RUN npm install -g pnpm@9.11.0

WORKDIR /app

# 复制运行应用所需的文件。
# 这些文件应由 CI/CD 流程中的上一个构建步骤提供。
COPY package.json ./
COPY pnpm-lock.yaml ./
COPY next.config.ts ./
COPY .next ./.next
COPY public ./public

# 只安装生产依赖。
# 使用 pnpm 以获得更快、更可靠的安装。
RUN pnpm install --prod --frozen-lockfile

# 设置生产环境变量
ENV NODE_ENV=production
# 浏览器包里的地址在 CI 的 next build 阶段写入；这里与 docker-compose 保持一致。
ENV NEXT_PUBLIC_API_URL=https://www.splendor.uno

# 暴露应用运行的端口
EXPOSE 3000

# 启动应用的命令
CMD ["pnpm", "start"] 